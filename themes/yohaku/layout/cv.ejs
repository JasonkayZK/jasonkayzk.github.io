<div class="page-container">
  <div class="page-label">Curriculum</div>
  <h1 class="page-title"><%= page.title %></h1>

  <p><a class="pub-link" href="<%- url_for('assets/cv.pdf') %>">Download CV (PDF)</a>

  <h2>Education</h2>
  <%- partial('partial/experience-list', {items: site.data.education}) %>

  <h2>Experience</h2>
  <%- partial('partial/experience-list', {items: site.data.experience}) %>

  <h2>Skills</h2>
  <div class="cv-skill-list">
    <% ((site.data.cv || {}).skills || []).forEach(function (s) {
         var sep = s.indexOf(':');
         var label = sep > -1 ? s.slice(0, sep).trim() : '';
         var body = sep > -1 ? s.slice(sep + 1).trim() : s;
    %>
    <div class="cv-skill-item">
      <% if (label) { %>
      <span class="cv-skill-label"><%= label %></span>
      <% } %>
      <span class="cv-skill-body"><%= body %></span>
    </div>
    <% }); %>
  </div>

  <h2>Awards</h2>
  <div class="timeline-list cv-award-list">
    <% ((site.data.cv || {}).awards || []).forEach(function (s, i) { %>
    <div class="timeline-item">
      <span class="timeline-index"><%= String(i + 1).padStart(2, '0') %></span>
      <div class="timeline-meta">
        <% var dash = s.indexOf('—'); var year = dash > -1 ? s.slice(0, dash).trim() : ''; %>
        <% if (year) { %><span><%= year %></span><% } %>
      </div>
      <div class="timeline-title"><%= dash > -1 ? s.slice(dash + 1).trim() : s %></div>
    </div>
    <% }); %>
  </div>
</div>
